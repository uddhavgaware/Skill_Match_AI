# ==============================================================
# SkillMatch AI - Environment Configuration Template
# Copy this file to .env and adjust variables for your target environment.
# ==============================================================

# Application Environment: 'production', 'staging', or 'development'
ENVIRONMENT=production

# Server Network Binding
HOST=0.0.0.0
PORT=8000

# Worker Concurrency (Default: auto-calculated based on CPU cores)
WORKERS=4

# Logging Verbosity: 'debug', 'info', 'warning', 'error', 'critical'
LOG_LEVEL=info

# Allowed Cross-Origin Resource Sharing (CORS) Origins
# Use '*' for universal access, or comma-separated URLs e.g. https://your-domain.com,https://app.your-domain.com
ALLOWED_ORIGINS=*

# Gunicorn Production Tuning (Linux / Docker)
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
